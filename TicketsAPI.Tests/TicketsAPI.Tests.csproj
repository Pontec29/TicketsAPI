<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketsAPI\TicketsAPI.csproj" />
  </ItemGroup>

  <!-- Los mismos scripts de /db se aplican en las pruebas de integración: así se verifica el esquema real. -->
  <ItemGroup>
    <None Include="..\db\01_schema.sql" Link="Scripts\01_schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\db\02_seed.sql" Link="Scripts\02_seed.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>